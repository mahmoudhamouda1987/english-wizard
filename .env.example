# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
OPENAI_API_KEY=sk-...

# Optional
# Force SSL behaviour for the database connection (auto-detected otherwise:
# local hosts = off, remote hosts like Supabase/Railway = on).
# DATABASE_SSL=true
# Comma-separated admin allowlist for /admin/content and review APIs.
# ADMIN_EMAILS=you@example.com
# AI model tier overrides (defaults: gpt-5.4-nano / gpt-5.4-mini / gpt-5.4)
# OPENAI_MODEL_FAST=
# OPENAI_MODEL_BALANCED=
# OPENAI_MODEL_PREMIUM=

# ── Audit environment (Parts 92–99) ─────────────────────────────────────────
# Enables the developer audit layer (level overrides, trial simulation,
# assessment reset, variant selection, seeded personas) at /audit.
# MUST remain false in production. Hard-locked off when NODE_ENV=production.
AUDIT_MODE=false
